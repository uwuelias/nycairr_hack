AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=generate-a-unique-32-byte-secret
APP_BASE_URL=http://localhost:3000
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Optional exact claim key if your Auth0 Action uses a custom username claim.
AUTH0_USERNAME_CLAIM=
# Optional: M2M app authorized for the Auth0 Management API with read:users.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Defaults to https://<AUTH0_DOMAIN>/api/v2/
AUTH0_MANAGEMENT_AUDIENCE=
MARKETPLACE_DATABASE_PATH=../backend/databases/marketplace.db
